# systemd unit for the Vitals agent (installed by install.sh).
[Unit]
Description=Vitals Hardware Monitoring Agent
Documentation=https://github.com/theallmyti/Vitals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/vitals/vitals /etc/vitals/config.toml
Restart=always
RestartSec=5

# Security hardening and sandboxing
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/etc/vitals
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryMax=100M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
